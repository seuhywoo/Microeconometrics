  2.     local ++r
  3.     local a : word 1 of `p'
  4.     local b : word 2 of `p'
  5.     local v = `a'
  6.     matrix A3[`r',1] = `v'
  7.     local v = `a' - bench_dw
  8.     matrix A3[`r',2] = `v'
  9.     if "`b'" != "." {
 10.         local v = `b'
 11.         matrix A3[`r',3] = `v'
 12.         local v = `b' - bench_la
 13.         matrix A3[`r',4] = `v'
 14.     }
 15. }

