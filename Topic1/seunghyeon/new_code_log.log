. program define dw_balance
  1.     args ps lab
  2.     tempvar sup blk w
  3.     quietly {
  4.         sum `ps' if treat==1
  5.         scalar B_tmin = r(min)
  6.         scalar B_tmax = r(max)
  7.         gen byte `sup' = (treat==1) | (`ps'>=B_tmin & `ps'<=B_tmax)
  8.         gen int `blk' = .
  9.         mata: dw_blocks("`ps'", "`sup'", "`blk'", 5, 1)
 10.         levelsof `blk', local(bl)
 11.         gen double `w' = 0
 12.         mata: dw_nn("`ps'", "`w'")
 13.     }
 14.     local nb : word count `bl'
 15.     di _n as txt "{hline 78}"
 16.     di as txt "Balance, score = `lab'   (blocks = `nb')"
 17.     di as txt %-11s "covariate" %11s "raw" %11s "strat" %11s "sig/tested" %11s "matched"
 18.     di as txt "{hline 78}"
 19.     foreach v of global BALX {
 20.         quietly {
 21.             sum `v' if treat==1
 22.             scalar B_m1 = r(mean)
 23.             scalar B_v1 = r(Var)
 24.             sum `v' if treat==0
 25.             scalar B_m0 = r(mean)
 26.             scalar B_v0 = r(Var)
 27.             scalar B_sd = sqrt((B_v1 + B_v0)/2)
 28.             scalar B_raw = (B_m1 - B_m0)/B_sd
 29. 
.             scalar B_acc = 0
 30.             scalar B_n1  = 0
 31.             scalar B_sig = 0
 32.             scalar B_tst = 0
 33.             foreach b of local bl {
 34.                 sum `v' if `blk'==`b' & treat==1
 35.                 scalar B_a_n = r(N)
 36.                 scalar B_a_m = r(mean)
 37.                 scalar B_a_v = r(Var)
 38.                 sum `v' if `blk'==`b' & treat==0
 39.                 scalar B_b_n = r(N)
 40.                 scalar B_b_m = r(mean)
 41.                 scalar B_b_v = r(Var)
 42.                 if B_a_n>0 & B_b_n>0 {
 43.                     scalar B_acc = B_acc + B_a_n*(B_a_m - B_b_m)
 44.                     scalar B_n1  = B_n1 + B_a_n
 45.                 }
 46.                 if B_a_n>=2 & B_b_n>=2 {
 47.                     scalar B_tst = B_tst + 1
 48.                     scalar B_se = sqrt(B_a_v/B_a_n + B_b_v/B_b_n)
 49.                     if B_se > 0 {
 50.                         if abs((B_a_m - B_b_m)/B_se) > 1.96 scalar B_sig = B_sig + 1
 51.                     }
 52.                 }
 53.             }
 54.             scalar B_strat = (B_acc/B_n1)/B_sd
 55. 
.             sum `v' [aw=`w'] if treat==1
 56.             scalar B_mm1 = r(mean)
 57.             sum `v' [aw=`w'] if treat==0 & `w'>0
 58.             scalar B_mm0 = r(mean)
 59.             scalar B_match = (B_mm1 - B_mm0)/B_sd
 60.         }
 61.         local sigtxt = string(B_sig) + "/" + string(B_tst)
 62.         di as txt %-11s "`v'" as res %11.3f B_raw %11.3f B_strat %11s "`sigtxt'" %11.3f B_match
 63.     }
 64.     di as txt "{hline 78}"
 65. end

. 
