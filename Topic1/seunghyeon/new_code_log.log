. capture program drop dw_table3

. program define dw_table3
  1.     args ps nstart dosplit
  2.     tempvar sup blk w ps2
  3.     quietly {
  4.         * (1), (2): score와 무관
.         regress re78 treat
  5.         scalar T3_c1 = _b[treat]
  6.         regress re78 treat $XA
  7.         scalar T3_c2 = _b[treat]
  8. 
.         * common support, (6)
.         sum `ps' if treat==1
  9.         scalar T3_pmin = r(min)
 10.         scalar T3_pmax = r(max)
 11.         gen byte `sup' = (treat==1) | (`ps'>=T3_pmin & `ps'<=T3_pmax)
 12.         count if `sup'
 13.         scalar T3_c6 = r(N)
 14. 
.         * (3)
.         gen double `ps2' = `ps'^2
 15.         regress re78 treat `ps' `ps2' if `sup'
 16.         scalar T3_c3 = _b[treat]
 17. 
.         * (4), (5)
.         gen int `blk' = .
 18.         mata: dw_blocks("`ps'", "`sup'", "`blk'", `nstart', `dosplit')
 19.         levelsof `blk', local(bl)
 20.         scalar T3_s4 = 0
 21.         scalar T3_s5 = 0
 22.         scalar T3_n1 = 0
 23.         scalar T3_nb = 0
 24.         foreach b of local bl {
 25.             count if `blk'==`b' & treat==1
 26.             scalar T3_nt = r(N)
 27.             count if `blk'==`b' & treat==0
 28.             scalar T3_nc = r(N)
 29.             if T3_nt>0 & T3_nc>0 {
 30.                 sum re78 if `blk'==`b' & treat==1
 31.                 scalar T3_m1 = r(mean)
 32.                 sum re78 if `blk'==`b' & treat==0
 33.                 scalar T3_m0 = r(mean)
 34.                 regress re78 treat $XA if `blk'==`b'
 35.                 scalar T3_s4 = T3_s4 + T3_nt*(T3_m1 - T3_m0)
 36.                 scalar T3_s5 = T3_s5 + T3_nt*_b[treat]
 37.                 scalar T3_n1 = T3_n1 + T3_nt
 38.                 scalar T3_nb = T3_nb + 1
 39.             }
 40.         }
 41.         scalar T3_c4 = T3_s4/T3_n1
 42.         scalar T3_c5 = T3_s5/T3_n1
 43. 
.         * (7), (8)
.         gen double `w' = 0
 44.         mata: dw_nn("`ps'", "`w'")
 45.         regress re78 treat $XA [aw=`w'] if `w'>0
 46.         scalar T3_c8 = _b[treat]
 47.     }
 48. end

