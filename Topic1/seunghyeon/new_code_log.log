. capture program drop ps_diag

. program define ps_diag
  1.     args v lab
  2.     quietly {
  3.         sum `v' if treat==1
  4.         scalar _tmin = r(min)
  5.         scalar _mT   = r(mean)
  6.         sum `v' if treat==0
  7.         scalar _mC   = r(mean)
  8.         count if treat==0 & `v' <  _tmin
  9.         scalar _disc = r(N)
 10.         count if treat==0 & `v' >= _tmin & `v' < 0.05
 11.         scalar _bin1 = r(N)
 12.         count if treat==1 & `v' > 0.8
 13.         scalar _t8   = r(N)
 14.         count if treat==0 & `v' > 0.8
 15.         scalar _c8   = r(N)
 16.     }
 17.     di as txt %-24s "`lab'" as res %8.4f _mT %8.4f _mC %8.0f _disc %7.0f _bin1 %6.0f _t8 %6.0f _c8
 18. end

