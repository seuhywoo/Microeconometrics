------------------------------------------------------------

. * -> 논문: NSW obs=185 mean=0.37 / Full CPS obs=15,992 mean=0.01
. 
. 
. * ----------------------------------------------------------
. * (A) Without-replacement matching: random / low-to-high / high-to-low
. *
. *   각 treated 유닛을 지정된 순서로 하나씩 처리하면서, 아직 안 쓰인
. *   control 중 propensity score가 가장 가까운 것을 하나 골라 매칭하고
. *   그 control을 pool에서 제거한다(그래서 "without replacement" —
. *   control 하나는 딱 한 번만 쓸 수 있다). one-to-one 매칭이라 obs는
. *   항상 185(=treated 수)로 나온다.
. * ----------------------------------------------------------
. 
. foreach order in random low_to_high high_to_low {
  2. 
.     * treated 185명을 원하는 순서로 정렬해서 ps 값을 행렬로 뽑아둔다
.     * (행렬에 담아두면, 아래에서 control pool 데이터를 메모리에
.     *  올려놓은 채로도 각 treated의 ps 값에 계속 접근할 수 있다).
.     preserve
  3.         keep if treat==1
  4.         if "`order'" == "random" {
  5.             set seed 20260927
  6.             gen double sortkey = runiform()
  7.         }
  8.         else if "`order'" == "low_to_high" {
  9.             gen double sortkey = ps
 10.         }
 11.         else {
 12.             gen double sortkey = -ps
 13.         }
 14.         sort sortkey
 15.         capture matrix drop tps_mat
 16.         mkmat ps, matrix(tps_mat)
 17.     restore
 18. 
.     * control pool: 아직 안 쓰였으면 used==0
.     preserve
 19.         keep if treat==0
 20.         keep id ps
 21.         gen byte used = 0
 22. 
.         tempname wr
 23.         tempfile wr_out
 24.         postfile `wr' matched_id double matched_ps using `wr_out', replace
 25. 
.         forvalues i = 1/185 {
 26.             local tps = tps_mat[`i',1]
 27. 
.             gen double dist = abs(ps - `tps')
 28.             quietly replace dist = . if used == 1
 29.             * missing은 ascending 정렬에서 항상 맨 뒤로 가므로, 이미
.             * 쓴 control은 자동으로 후보에서 빠진다.
.             sort dist
 30.             local bestid = id[1]
 31.             local bestps = ps[1]
 32.             quietly replace used = 1 if id == `bestid'
 33.             drop dist
 34. 
.             post `wr' (`bestid') (`bestps')
 35.         }
 36.         postclose `wr'
 37. 
.         use `wr_out', clear
 38.         di _n as txt "Without replacement (`order'): obs = " as res %6.0f _N
 39.         sum matched_ps
 40.     restore
 41. }
