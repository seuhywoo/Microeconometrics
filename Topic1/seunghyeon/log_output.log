. foreach v of global X {
  2.     quietly sum `v' if treat==1
  3.     local mt = r(mean)
  4.     local vt = r(Var)
  5.     quietly sum `v' if treat==0
  6.     local mc = r(mean)
  7.     local vc = r(Var)
  8.     local draw = (`mt'-`mc')/sqrt((`vt'+`vc')/2)
  9. 
.     quietly sum `v' if treat==1 [aw=w]
 10.     local mt2 = r(mean)
 11.     local vt2 = r(Var)
 12.     quietly sum `v' if treat==0 [aw=w]
 13.     local mc2 = r(mean)
 14.     local vc2 = r(Var)
 15.     local dmat = (`mt2'-`mc2')/sqrt((`vt2'+`vc2')/2)
 16.     local vrat = `vt2'/`vc2'
 17. 
.     if abs(`dmat') > `worst' {
 18.         local worst = abs(`dmat')
 19.         local worstv "`v'"
 20.     }
 21.     di as txt %-12s "`v'" as res %16.4f `draw' %18.4f `dmat' %18.4f `vrat'
 22. }
